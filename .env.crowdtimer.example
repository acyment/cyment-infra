# CrowdTimer runtime secrets and deployment configuration.
# Production uses ~/.config/cyment-infra/crowdtimer.env, materialized from the
# protected GitHub production environment. Never commit the real file.

CROWDTIMER_PB_ADMIN_EMAIL=admin@example.com
CROWDTIMER_PB_ADMIN_PASSWORD=replace-with-a-strong-password
CROWDTIMER_PUBLIC_DOMAIN=live.crowdtimer.app
CROWDTIMER_ZOOM_CLIENT_ID=replace-with-zoom-client-id
CROWDTIMER_ZOOM_CLIENT_SECRET=replace-with-zoom-client-secret
CROWDTIMER_MEETING_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Optional feedback notifications.
CROWDTIMER_RESEND_API_KEY=
CROWDTIMER_FEEDBACK_NOTIFY_EMAIL=

# Production diagnostics remain disabled unless explicitly configured.
CROWDTIMER_ENABLE_PROD_CCLOG=0
CROWDTIMER_PROD_CCLOG_TOKEN=
CROWDTIMER_CCLOG_TOKEN=
CROWDTIMER_ZOOM_SAFE_MODE=0
CROWDTIMER_VITE_STARTUP_PERF=0

# Optional privacy-friendly analytics for the static marketing site.
CROWDTIMER_PUBLIC_GOATCOUNTER_URL=
CROWDTIMER_PUBLIC_UMAMI_SRC=https://umami.cyment.com/script.js
CROWDTIMER_PUBLIC_UMAMI_WEBSITE_ID=

# A remotely managed Cloudflare Tunnel token is mounted as a Docker secret.
CROWDTIMER_TUNNEL_TOKEN_FILE=/home/acyment/.config/cyment-infra/crowdtimer-tunnel-token
